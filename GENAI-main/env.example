# ==============================================
# GenAI Hiring System Environment Configuration
# Copy this file to .env and update the values
# ==============================================

# ==============================================
# APPLICATION SETTINGS
# ==============================================
ENVIRONMENT=development
SECRET_KEY=your-super-secure-secret-key-change-this-in-production
DEBUG=true
FRONTEND_URL=http://localhost:3000

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_change_this
POSTGRES_DB=genai_hiring
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:secure_password_change_this@postgres:5432/genai_hiring

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ==============================================
# API CONFIGURATION
# ==============================================
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_PORT=8000
API_BASE_URL=http://localhost:8000

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENVIRONMENT=development
REACT_APP_HOST=localhost
REACT_APP_PORT=3000

# ==============================================
# JWT CONFIGURATION
# ==============================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==============================================
# EMAIL CONFIGURATION (Required for notifications)
# ==============================================
SMTP_SERVER=smtp.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
EMAIL_FROM=your-email@gmail.com

# ==============================================
# LLM CONFIGURATION
# ==============================================
# Ollama Configuration (for local LLM)
OLLAMA_PORT=11434
OLLAMA_HOST=ollama
OLLAMA_MODEL=qwen2.5:3b-instruct

# Legacy Phi-3 Configuration
PHI3_MODEL_ID=microsoft/phi-3-mini-4k-instruct

# ==============================================
# FILE UPLOAD CONFIGURATION
# ==============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=pdf,doc,docx

# ==============================================
# SCORING CONFIGURATION
# ==============================================
MATCH_SCORE_WEIGHT=0.5
ATS_SCORE_WEIGHT=0.5
SHORTLIST_THRESHOLD=70
REQUALIFY_THRESHOLD=60

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
LOG_LEVEL=INFO
LOG_FILE=logs/genai-hiring.log

# ==============================================
# GOOGLE MEET API (Optional)
# ==============================================
# Place credentials.json in backend directory
# Run: python setup_google_meet_oauth.py
